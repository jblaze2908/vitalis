# Vitalis reads only VITALIS_* variables (and TZ). Copy to /etc/vitalis/vitalis.env (or anywhere) and adjust.

# Data directory: the SQLite file lives here. Back it up.
VITALIS_ROOT=/srv/vitalis
# Your time zone: decides what "today" and "last night" mean when an agent gives no date.
VITALIS_TZ=Asia/Kolkata
# Public host of this instance (for the Origin check on /mcp), without scheme.
VITALIS_HOST=vitalis.example.com
# Inside the container listen on all interfaces; publish the port on loopback only (see deploy/compose.yml).
VITALIS_BIND=0.0.0.0
PORT=8350
# Host address the container's port is published on (compose reads it from this file via --env-file).
VITALIS_PUBLISH=127.0.0.1:8350
# Optional: tell an agent runtime when last night's sleep has arrived (Standard Webhooks, e.g. a Pitcrew event
# trigger). Fires "sleep.ready" once a day, with the day only, no values.
VITALIS_HOOK_URL=
VITALIS_HOOK_SECRET=
# Largest push accepted, in MB. Turn on Batch Requests in Health Auto Export if a backfill is bigger.
VITALIS_MAX_INGEST_MB=50
